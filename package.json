{
  "name": "@ndom91/opencode-hud",
  "version": "0.2.2",
  "description": "Persistent native status HUD for the OpenCode 2 TUI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndom91/opencode-hud.git"
  },
  "bugs": "https://github.com/ndom91/opencode-hud/issues",
  "homepage": "https://github.com/ndom91/opencode-hud#readme",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome check .",
    "format:write": "biome check --write .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-17898"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@opentui/core": "0.5.6",
    "@opentui/solid": "0.5.6",
    "@types/node": "^24.12.2",
    "solid-js": "1.9.10",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
